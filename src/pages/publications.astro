---
import BaseLayout from '@layouts/base-layout.astro'

const degrees = [
  'An Ensemble Model for Software Development Cost Estimation, Maher et. al. SRITI 2022',
  'An Overview of Machine Learning Approaches to Software Development Cost Estimation, Maher et. al. ICCITM 2022',
]
---

<BaseLayout>
  <h3 class='capitalize font-medium mb-3'>Publications</h3>
  <ul class='list-["-_"] list-inside font-light'>
    {degrees.map((degree) => <li class='mb-3'>{degree}</li>)}
  </ul>
</BaseLayout>
