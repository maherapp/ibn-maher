---
import BaseLayout from '@layouts/base-layout.astro'
import { publications } from '../data/publications'
---

<BaseLayout>
  <h3 class='font-medium mb-4'>Publications</h3>
  <ol class='flex flex-col gap-6 font-light list-none'>
    {
      publications.map((pub) => (
        <li>
          <a href={pub.pdf} class='font-medium border-b'>
            {pub.title}
          </a>
          <div class='text-sm mt-1'>
            {pub.authors.map((a, i) => (
              <>
                {a.me ? <strong class='font-medium'>{a.name}</strong> : a.name}
                {i < pub.authors.length - 1 ? ', ' : ''}
              </>
            ))}
          </div>
          <div class='text-sm italic'>
            {pub.venue}, {pub.year}
          </div>
          <div class='text-sm mt-1 flex gap-2'>
            <a href={pub.pdf} target='_blank' class='border-b'>
              [PDF]
            </a>
            <a href={pub.doi} target='_blank' class='border-b'>
              [DOI]
            </a>
          </div>
          <p class='text-sm mt-2'>{pub.finding}</p>
        </li>
      ))
    }
  </ol>
  <a
    href='/#publications'
    class='inline-block mt-3 text-sm border-b underline-offset-2'>← Back</a
  >
</BaseLayout>
